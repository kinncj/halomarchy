[Unit]
Description=Heimdall metrics daemon (streams to hub)
Documentation=https://github.com/kinncj/Heimdall
Wants=network-online.target heimdall-helper.service
After=network-online.target tailscaled.service heimdall-helper.service

[Service]
Type=simple
User=@USER@
Group=@USER@
SupplementaryGroups=heimdall
Environment=HEIMDALL_HELPER_SOCKET=/run/heimdall/helper.sock
Environment=PATH=/opt/rocm/bin:/usr/local/sbin:/usr/local/bin:/usr/bin
ExecStart=/usr/bin/heimdall-daemon \
    --hub @HEIMDALL_HUB@ \
    --name %H \
    --tags env=home,role=mobile-workstation,type=laptop
# The daemon auto-reconnects to the hub itself; Restart only covers a hard exit.
Restart=always
RestartSec=5s
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
